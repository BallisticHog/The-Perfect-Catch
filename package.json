{
    "name": "the-perfect-catch",
    "version": "0.1.0",
    "private": true,
    "description": "Private South African school rowing results catalogue",
    "packageManager": "pnpm@10.32.1",
    "engines": {
        "node": ">=20.9.0",
        "pnpm": ">=10.0.0"
    },
    "scripts": {
        "build": "pnpm -r --if-present build",
        "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm check:no-em-dash",
        "check:no-em-dash": "node scripts/check-no-em-dash.mjs",
        "dev": "pnpm --parallel --filter @the-perfect-catch/web --filter @the-perfect-catch/worker dev",
        "format": "dprint fmt",
        "format:check": "dprint check",
        "lint": "eslint .",
        "test": "pnpm -r --if-present test",
        "test:e2e": "pnpm --filter @the-perfect-catch/web test:e2e",
        "typecheck": "pnpm -r --if-present typecheck"
    },
    "devDependencies": {
        "@stylistic/eslint-plugin": "5.10.0",
        "@types/node": "22.20.2",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "dprint": "0.57.4",
        "eslint": "9.39.5",
        "eslint-config-next": "16.3.5",
        "next": "16.3.5",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "typescript": "5.9.3",
        "vitest": "5.0.0"
    }
}
