{
    "$schema": "https://dprint.dev/schemas/v0.json",
    "incremental": true,
    "indentWidth": 4,
    "lineWidth": 110,
    "newLineKind": "lf",
    "useTabs": false,
    "typescript": {
        "bracePosition": "nextLine",
        "jsx.bracketPosition": "nextLine",
        "nextControlFlowPosition": "nextLine",
        "quoteStyle": "alwaysDouble",
        "semiColons": "always"
    },
    "json": {
        "indentWidth": 4
    },
    "markdown": {
        "lineWidth": 110,
        "textWrap": "maintain"
    },
    "excludes": [
        "**/.next/**",
        "**/coverage/**",
        "**/dist/**",
        "**/node_modules/**",
        "**/pnpm-lock.yaml",
        "docs/design/references/**",
        "packages/ingestion/fixtures/raw/**"
    ],
    "plugins": [
        "https://plugins.dprint.dev/typescript-0.96.1.wasm",
        "https://plugins.dprint.dev/json-0.23.0.wasm",
        "https://plugins.dprint.dev/markdown-0.24.0.wasm",
        "https://plugins.dprint.dev/g-plane/malva-v0.16.0.wasm",
        "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm"
    ]
}
