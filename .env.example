# Application
APP_BASE_URL=http://localhost:3000
NODE_ENV=development
PUBLIC_CONTACT_EMAIL=replace-with-contact@example.invalid
SITE_PUBLIC_RELEASE_ENABLED=false

# Authentication
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
BOOTSTRAP_GOOGLE_EMAIL=
BOOTSTRAP_SECRET_SHA256=

# Data and worker
DATABASE_URL=postgres://catch:replace-me@localhost:5432/catch
REGATTA_RESULTS_USER_AGENT=The-Catch/0.1 (+replace-with-contact-url)
MEDIA_ROOT=.data/media
SNAPSHOT_ROOT=.data/snapshots
CATCH_LIVE_ROOT=.data/live
CATCH_LIVE_SNAPSHOT_ROOT=.data/live/sources

# Deployment
CATCH_DOMAIN=catch.example.com
POSTGRES_PASSWORD=replace-me
