# Copy outside the checkout to /etc/the-perfect-catch/production.env, owner root, mode 600.
# Never put real secrets in this example or pass them as image build arguments.
CATCH_DOMAIN=catch.example.com
ACME_EMAIL=operator@example.invalid
GHCR_NAMESPACE=replace-owner/replace-repository
IMAGE_TAG=0000000000000000000000000000000000000000
POSTGRES_PASSWORD=replace-with-a-random-url-safe-password
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
BOOTSTRAP_GOOGLE_EMAIL=
BOOTSTRAP_SECRET_SHA256=
PUBLIC_CONTACT_EMAIL=operator@example.invalid
REGATTA_RESULTS_USER_AGENT=The-Catch/0.1 (+https://catch.example.com/contact)
